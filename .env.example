# Optional – ohne diese Werte läuft die App mit dem Speicher auf dem Gerät.
# Mit ihnen liegen alle Reisen in einem gemeinsamen Datenbestand (supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional – bessere Ortssuche und mehr Bilder. Die Schlüssel bleiben auf dem Server.
GOOGLE_MAPS_API_KEY=
PLACES_API_KEY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Die Karte braucht keinen Schlüssel: offene Kacheln von OpenStreetMap, Esri als Rückhalt.
# Nur wer Kacheln von einem eigenen Dienst (oder MapTiler, Stadia …) laden will, setzt das –
# die Adresse muss {z}/{x}/{y} enthalten, dann steht sie vorn und die offenen dienen als Rückfall.
# NEXT_PUBLIC_KARTE_KACHELN=


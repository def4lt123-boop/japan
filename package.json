{
  "name": "urlaubsplaner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed:sql": "node scripts/emit-seed-sql.mjs",
    "smoke": "tsx scripts/smoke.mts",
    "test:render": "node -r tsx/cjs scripts/render-test.cjs",
    "test:store": "tsx scripts/smoke.mts",
    "test:dayplan": "tsx scripts/dayplan-test.mts",
    "test:all": "npm run typecheck && npm run test:dayplan && npm run test:store && npm run test:category && npm run test:today && npm run test:dates && npm run test:checks && npm run test:mode && npm run test:layout && npm run test:render",
    "test:layout": "tsx scripts/layout-check.mts",
    "test:category": "tsx scripts/category-test.mts",
    "test:today": "tsx scripts/today-test.mts",
    "test:mode": "tsx scripts/mode-test.mts",
    "test:dates": "tsx scripts/date-test.mts",
    "test:checks": "tsx scripts/checks-test.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
